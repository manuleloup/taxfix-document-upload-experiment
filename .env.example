# Anthropic API key — used server-side only, by /api/classify.
# Get one at console.anthropic.com → API keys.
ANTHROPIC_API_KEY=

# Which model reads the documents, and how hard it thinks. These are
# per-request parameters, not account settings — there is nothing to
# configure in the Anthropic console.
#
# Measured on a P60 fixture (latency / did it flag a genuinely ambiguous
# figure as uncertain?):
#   claude-sonnet-5  low     5.7s  · 0.40  ← default: fast and calibrated
#   claude-sonnet-5  medium  6.0s  · 0.30
#   claude-opus-5    high   10.1s  · 0.62
#   claude-haiku-4-5 none    3.4s  · 0.99  ← fastest, but overconfident:
#       it rates ambiguous figures as certain, which disables the
#       "worth a check" flag and the confirm gate that depend on that score.
#
# CLASSIFY_EFFORT accepts low | medium | high | xhigh | max, or `none` to
# omit the parameter entirely (Haiku 4.5 rejects it with a 400).
CLASSIFY_MODEL=claude-sonnet-5
CLASSIFY_EFFORT=low

# Set to 1 to click through the flow with canned documents — no API key
# needed and no spend. See src/app/api/classify/mock-documents.ts.
CLASSIFY_MOCK=0
