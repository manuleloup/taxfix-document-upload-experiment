# Gemini API key — used server-side only, by /api/classify, /api/overlap, /api/chat.
# Get one at aistudio.google.com → Get API key.
GEMINI_API_KEY=

# Which Gemini model reads the documents. Flash is the default: fast and
# capable for structured extraction. Pro is more capable but slower and costs more.
#
# Suggested options:
#   gemini-2.0-flash      ← default: fast and well-calibrated
#   gemini-2.5-flash      ← slightly more capable, similar latency
#   gemini-2.5-pro        ← most capable; slower (~10–15s per document)
CLASSIFY_MODEL=gemini-2.0-flash

# Set to 1 to click through the flow with canned documents and a canned chat
# reply — no API key needed and no spend. Uploads are still stored on disk in
# mock mode. See src/app/api/classify/mock-documents.ts.
CLASSIFY_MOCK=0

# Where uploaded documents are kept so /api/chat can re-read one when a
# question needs more than the extracted summary. Defaults to a folder under
# the OS temp dir; session folders are swept after 12h untouched.
#
# ⚠️  This is a LOCAL-DEVELOPMENT STAND-IN for the real storage bucket, and
# only works because the app runs as one process on one machine. It will not
# survive serverless deployment (no shared disk between instances), and files
# sit unencrypted on disk — so use sample/dummy paperwork while developing,
# not real financial documents. See src/app/_lib/document-store.ts.
# DOCUMENT_STORE_DIR=

# Keep the figures from a file the classifier judged not to be an issued
# record (no letterhead, reference or period — see CLASSIFY_SYSTEM). Needed to
# test the flow with specimen-stamped fixtures, since several of the mock
# documents print "SPECIMEN — not a genuine document" and the model reads it.
# Development only.
ALLOW_UNVERIFIED_DOCUMENTS=0
